<Window x:Class="ImageSelector.AnnotationEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/ImageSelector.ico"
        Title="注釈入力"
        Width="760" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#121826" Foreground="#F8FAFC"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#334155" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style x:Key="AnnotationRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="3,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#115E59" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="画像の注釈" FontSize="21" FontWeight="Bold" />
            <TextBlock Text="Esc: 文字入力を解除 → M/F/C/E/H: 注釈追加。Alt+Enter: 下書きに反映して待機状態へ（閉じない）。Ctrl+Enter: 画像とJSONを保存。"
                       Foreground="#A6B3C7" TextWrapping="Wrap" Margin="0,6,0,0" />
            <Border x:Name="ShortcutFocusTarget" Focusable="True" KeyboardNavigation.IsTabStop="True"
                    InputMethod.IsInputMethodEnabled="False"
                    Background="#162237" BorderBrush="#475569" BorderThickness="1" CornerRadius="4"
                    Padding="8,5" Margin="0,10,0,0">
                <TextBlock Text="ショートカット待機領域（日本語IMEがONでもM/F/C/E/Hで追加）"
                           Foreground="#67E8F9" FontSize="12" />
            </Border>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button Content="＋ M 男性セリフ" Tag="male" Style="{StaticResource EditorButton}" Click="Add_Click" />
            <Button Content="＋ F 女性セリフ" Tag="female" Style="{StaticResource EditorButton}" Click="Add_Click" />
            <Button Content="＋ C キャプション" Tag="caption" Style="{StaticResource EditorButton}" Click="Add_Click" />
            <Button Content="＋ E 効果音" Tag="sound_effect" Style="{StaticResource EditorButton}" Click="Add_Click" />
            <Button Content="＋ H 吹き出し" Tag="speech_bubble" Style="{StaticResource EditorButton}" Click="Add_Click" />
        </WrapPanel>

        <ListBox x:Name="EntriesList" Grid.Row="2" Background="#0B1220" BorderBrush="#475569"
                 BorderThickness="1" ItemContainerStyle="{StaticResource AnnotationRow}"
                 SelectionChanged="EntriesList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="106" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayType}" FontWeight="SemiBold"
                                   Foreground="#67E8F9" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Preview}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,13,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="EditingLabel" Grid.Row="0" Grid.Column="0"
                       Text="行を追加して編集" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MoveUpButton" Content="↑ 上へ" Style="{StaticResource EditorButton}" Click="MoveUp_Click" />
                <Button x:Name="MoveDownButton" Content="↓ 下へ" Style="{StaticResource EditorButton}" Click="MoveDown_Click" />
                <Button x:Name="RemoveButton" Content="削除" Style="{StaticResource EditorButton}" Click="Remove_Click" />
            </StackPanel>
            <TextBox x:Name="AnnotationTextBox" Grid.Row="1" Grid.ColumnSpan="2" Height="104"
                     IsEnabled="False" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" TextChanged="AnnotationTextBox_TextChanged"
                     GotKeyboardFocus="AnnotationTextBox_GotKeyboardFocus"
                     FontSize="16" Padding="9" Foreground="#111827" Background="#FFFFFF" />
        </Grid>

        <StackPanel Grid.Row="4">
            <TextBlock x:Name="EditingStatusText" Text="Escで文字入力解除。Escをもう一度押すとキャンセル。"
                       Foreground="#A6B3C7" FontSize="12" Margin="0,0,0,7" />
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="注釈だけ反映 (Alt+Enter)"
                        Style="{StaticResource EditorButton}" Click="SaveDraft_Click" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="注釈確定＋画像保存 (Ctrl+Enter)"
                        Style="{StaticResource EditorButton}" Background="#0F766E"
                        Click="SaveAndSelect_Click" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="キャンセル" IsCancel="True"
                        Style="{StaticResource EditorButton}" Margin="8,0,0,0" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
